# Read by Python only. Never paste this key into the browser.
SERPAPI_API_KEY=your_serpapi_api_key_here

# Conservative LOCAL limits; these do not synchronize with your SerpApi account.
# Zero blocks all new searches. All periods use UTC calendar boundaries.
MONTHLY_SEARCH_LIMIT=200
DAILY_SEARCH_LIMIT=20
HOURLY_SEARCH_LIMIT=40
PORT=5000
